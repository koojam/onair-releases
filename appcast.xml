    <item>
      <title>On Air 1.3</title>
      <pubDate>Mon, 19 Oct 2026 18:37:17 +0000</pubDate>
      <sparkle:version>202610191435</sparkle:version>
      <sparkle:shortVersionString>1.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<ul><li>Live transcription shows in a dark glass bubble while you talk</li><li>Past takes are tucked away: tap the clock above the ON AIR sign to see your last 3</li><li>Notices now appear under the mic, yellow for info and red for problems</li><li>Clear Liquid Glass throughout</li></ul>]]></description>
